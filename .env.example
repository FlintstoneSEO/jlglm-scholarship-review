SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Canonical deployment origin, with no path or trailing slash. APP_URL is read only
# by server invitation code; VITE_APP_URL is intentionally available to the browser
# so password recovery emails can return to this deployment.
APP_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000

# Server-only. Never prefix this with VITE_ or expose it to browser code.
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-secret

# Applicant decision emails: server-only, disabled until mailbox authorization and
# controlled test-recipient verification are complete. Never use VITE_ prefixes.
APPLICANT_EMAIL_ENABLED=false
# APPLICANT_EMAIL_TEST_RECIPIENT=an-inbox-you-control@example.org
# APPLICANT_GMAIL_CLIENT_ID=your-google-oauth-client-id
# APPLICANT_GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
# APPLICANT_GMAIL_REFRESH_TOKEN=offline-token-for-info-at-justiceleagueglm-org
